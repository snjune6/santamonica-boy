rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Only signed-in Authentication users can download installers
    match /downloads/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
